<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AAALogistics.Client.Views.SalesView">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,8">
            <StackPanel x:Name="TitleRow" Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="page-title" Text="Pedidos de venta" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="muted"
                       Text="Cree y confirme el pedido aquí. Picking en ALMACÉN → Preparación → Marcar preparado. Luego Contabilizar entrega (DN/PGI; solo si está Preparado). Elija el albarán por número para PDF/Imprimir."
                       TextWrapping="Wrap" />
            <Border Classes="action-bar">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Content="Actualizar" Click="OnRefreshClick" />
                    <Button x:Name="ConfirmButton" Classes="secondary" Content="Confirmar" Click="OnConfirmClick" />
                    <ContentControl x:Name="ConfirmHelpHost" VerticalAlignment="Center" />
                    <Button x:Name="CancelButton" Classes="secondary" Content="Cancelar pedido" Click="OnCancelClick" />
                    <ContentControl x:Name="CancelHelpHost" VerticalAlignment="Center" />
                    <Button x:Name="CloseButton" Classes="secondary" Content="Cerrar pedido" Click="OnCloseClick" />
                    <ContentControl x:Name="CloseHelpHost" VerticalAlignment="Center" />
                    <Button x:Name="RejectButton" Classes="secondary" Content="Rechazar pedido" Click="OnRejectClick" />
                    <ContentControl x:Name="RejectHelpHost" VerticalAlignment="Center" />
                    <Button x:Name="PdfSoButton" Classes="secondary" Content="PDF pedido" Click="OnPdfClick"
                            ToolTip.Tip="Genera y guarda el PDF del pedido de venta." />
                    <Button x:Name="PrintSoButton" Classes="secondary" Content="Imprimir" Click="OnPrintClick"
                            ToolTip.Tip="Abre opciones de impresión (impresora Windows o abrir PDF)." />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <TextBlock FontWeight="SemiBold" Text="Nuevo pedido de venta" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" Text="Cliente" />
                            <ComboBox x:Name="CustomerBox" Width="220" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" Text="Almacén" />
                            <ComboBox x:Name="WarehouseBox" Width="200" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" Text="Material" />
                            <ComboBox x:Name="MaterialBox" Width="240" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" Text="Cantidad" />
                            <TextBox x:Name="QtyBox" Width="90" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="muted" Text="Incoterms (condición de entrega)" VerticalAlignment="Center" />
                                <ContentControl x:Name="IncotermsHelpHost" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="IncotermsBox" Width="90" PlaceholderText="Ej. DAP" />
                        </StackPanel>
                        <StackPanel Spacing="2">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="muted" Text="Ref. aduanas" VerticalAlignment="Center" />
                                <ContentControl x:Name="CustomsHelpHost" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBox x:Name="CustomsBox" Width="120" PlaceholderText="Opcional" />
                        </StackPanel>
                        <Button Content="Añadir línea" VerticalAlignment="Bottom" Click="OnAddLineClick" />
                        <Button Content="Quitar línea" VerticalAlignment="Bottom" Click="OnRemoveLineClick" />
                        <Button x:Name="CreateButton" Classes="primary" Content="Crear pedido"
                                VerticalAlignment="Bottom" Click="OnCreateClick" />
                    </StackPanel>
                    <DataGrid x:Name="DraftLinesGrid" Height="72" AutoGenerateColumns="False" />
                </StackPanel>
            </Border>
            <Border Classes="panel">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock FontWeight="SemiBold" Text="Entrega / devolución / documentos" VerticalAlignment="Center" />
                        <ContentControl x:Name="DnHelpHost" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" Text="Cantidad entrega" />
                            <TextBox x:Name="DnQtyBox" Width="90" />
                        </StackPanel>
                        <Button x:Name="PostDnButton" Classes="primary" Content="Contabilizar entrega"
                                VerticalAlignment="Bottom" Click="OnPostDnClick"
                                ToolTip.Tip="Requiere permiso de entrega" />
                        <Button x:Name="PostAllDnButton" Classes="secondary" Content="Entregar abiertas"
                                VerticalAlignment="Bottom" Click="OnPostAllDnClick"
                                ToolTip.Tip="Entrega todas las líneas con cantidad abierta (pedido Preparado)." />
                        <Button x:Name="ReturnButton" Classes="secondary" Content="Devolución de entrada"
                                VerticalAlignment="Bottom" Click="OnReturnClick" />
                        <ContentControl x:Name="ReturnHelpHost" VerticalAlignment="Center" />
                        <StackPanel Spacing="2">
                            <TextBlock Classes="muted" Text="Entrega (albarán)" />
                            <ComboBox x:Name="DeliveryBox" Width="260"
                                      PlaceholderText="Elija entrega por número" />
                        </StackPanel>
                        <Button x:Name="DeliveryPdfButton" Classes="secondary" Content="PDF entrega"
                                VerticalAlignment="Bottom" Click="OnDeliveryPdfClick" />
                        <ContentControl x:Name="DeliveryPdfHelpHost" VerticalAlignment="Center" />
                        <Button x:Name="PrintDeliveryButton" Classes="secondary" Content="Imprimir entrega"
                                VerticalAlignment="Bottom" Click="OnPrintDeliveryClick"
                                ToolTip.Tip="Imprime el albarán/entrega (impresora Windows)." />
                        <Button x:Name="PackingPdfButton" Classes="secondary" Content="Lista de empaque"
                                VerticalAlignment="Bottom" Click="OnPackingListClick" />
                        <ContentControl x:Name="PackingHelpHost" VerticalAlignment="Center" />
                        <Button x:Name="PrintPackingButton" Classes="secondary" Content="Imprimir empaque"
                                VerticalAlignment="Bottom" Click="OnPrintPackingClick" />
                        <Button x:Name="CreateHuButton" Classes="secondary" Content="Alta bulto (SSCC)"
                                VerticalAlignment="Bottom" Click="OnCreateHuClick" />
                        <ContentControl x:Name="HuHelpHost" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Classes="error" TextWrapping="Wrap" />
            <TextBlock x:Name="EmptyHint" Classes="muted" IsVisible="False" TextWrapping="Wrap"
                       Text="No hay pedidos de venta. Cree uno, confírmelo, prepare en ALMACÉN → Preparación y vuelva a contabilizar la entrega aquí." />
        </StackPanel>
        <Grid ColumnDefinitions="2*,*" RowDefinitions="*">
            <DataGrid x:Name="OrdersGrid"
                      AutoGenerateColumns="False"
                      SelectionChanged="OnOrderSelected" />
            <DataGrid x:Name="LinesGrid"
                      Grid.Column="1"
                      Margin="8,0,0,0"
                      AutoGenerateColumns="False" />
        </Grid>
    </DockPanel>
</UserControl>
