{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "AAA Logistics",
    "InternalAudience": "aaa-logistics-internal",
    "PortalAudience": "aaa-logistics-portal",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14,
    "SigningKeyPath": "Data/keys/jwt.key"
  },
  "Listeners": {
    "InternalUrl": "http://127.0.0.1:5088",
    "PortalUrl": "http://127.0.0.1:5089"
  },
  "Legal": {
    "RequireLegalTexts": false,
    "CurrentVersion": ""
  },
  "PasswordHashing": {
    "MemorySizeKb": 65536,
    "Iterations": 3,
    "DegreeOfParallelism": 2,
    "MaxConcurrentOperations": 2
  },
  "FirstBoot": {
    "AdminUserName": "",
    "AdminPassword": ""
  },
  "Email": {
    "Mode": "Disabled",
    "FileDirectory": "Data/emails"
  },
  "Audit": {
    "PiiMasterKeyPath": "Data/keys/pii-master.key",
    "RetentionDays": 365,
    "CheckpointDirectory": "Data/audit-checkpoints",
    "RetentionJobEnabled": true,
    "RetentionPollHours": 24
  },
  "Backups": {
    "Directory": "Data/backups",
    "PgDumpPath": "pg_dump",
    "TimeoutMinutes": 30,
    "AllowSqlFallback": false,
    "EncryptionKeyPath": "Data/keys/backup.key"
  },
  "Demo": {
    "AllowSeed": false
  },
  "Sap": {
    "Enabled": false,
    "BaseUrl": "",
    "UserName": "",
    "Password": "",
    "BearerToken": "",
    "TimeoutSeconds": 30,
    "MaterialsPath": "/sap/opu/odata/sap/API_PRODUCT_SRV/A_Product",
    "DeliveryPushPath": "/sap/opu/odata/sap/API_OUTBOUND_DELIVERY_SRV/A_OutbDeliveryHeader",
    "DefaultUnitCode": "UN",
    "OutboxPollSeconds": 15
  }
}
