<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <LangVersion>latest</LangVersion>
    <Company>Triple AAA Logistics Estudio</Company>
    <Product>AAA Logistics</Product>
    <Authors>Triple AAA Logistics Estudio contributors</Authors>
    <NeutralLanguage>es-ES</NeutralLanguage>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <!-- Console/UI entry points and Avalonia generated partials -->
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1852</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.Contains('.Tests'))">
    <NoWarn>$(NoWarn);CA1707</NoWarn>
  </PropertyGroup>
</Project>
